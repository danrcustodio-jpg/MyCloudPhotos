# Absolute path to your My Cloud Home photo root (mapped drive or UNC).
# Examples:
#   PHOTO_ROOT=Z:\Photos
#   PHOTO_ROOT=\\MYCLOUD-XXXX\Username\Photos
PHOTO_ROOT=

# Local cache for SQLite index and thumbnails (defaults to ./data)
DATA_DIR=./data

# Thumbnail max edge length in pixels
THUMB_SIZE=320

# Parallel file analyzes over SMB (1–8). On My Cloud Home, 1–2 is often fastest.
SCAN_WORKERS=2

# Near-duplicate Hamming distance threshold (0–64; lower = stricter)
PHASH_THRESHOLD=8

# How many iCloud assets to download/import/verify per archive batch
ICLOUD_ARCHIVE_BATCH_SIZE=500

# Extra Import source roots (semicolon-separated). PHOTO_ROOT plus
# Downloads/Desktop/Pictures/Documents/OneDrive are always allowed when present.
# Example: IMPORT_ALLOW_PREFIXES=E:\phone_dump;D:\CameraRoll
IMPORT_ALLOW_PREFIXES=
